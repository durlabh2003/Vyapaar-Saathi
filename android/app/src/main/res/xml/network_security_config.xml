<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Config for BusinessBuddy (Capacitor WebView)
  Allows HTTPS connections to Supabase and standard web domains.
  Does NOT allow cleartext (HTTP) to prevent security issues.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Allow all HTTPS traffic for Supabase and standard CDNs -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">supabase.co</domain>
        <domain includeSubdomains="true">supabase.in</domain>
        <domain includeSubdomains="true">googleapis.com</domain>
        <domain includeSubdomains="true">gstatic.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
